<?xml version="1.0" encoding="UTF-8"?>
<!--
Maps physical Monarch controls to Android keycodes so they reach
onKeyDown -- confirmed via the vendor's Command Summary doc + a working
reference project (MonarchBlocks) that none of these keycodes are
auto-forwarded; each needs its own entry here, or it never arrives.

- Zoom In/Out: real chassis buttons -> KEYCODE_ZOOM_IN (168) / KEYCODE_ZOOM_OUT (169).
- Enter: NOT a chassis button -- it's Dot 8 on the braille keyboard.
  Confirmed on-device via adb logcat that omitting this entry means
  KEYCODE_ENTER (66) never reaches onKeyDown at all.

D-pad center and Space are deliberately NOT mapped: the vendor's Command
Summary never lists a D-pad center/select function (confirmed: this
device's D-pad has no center push, matching what pressing it on the real
unit shows), and no working reference project maps Space -- it's also a
modifier prefix for many reserved shortcuts (see "Commands not to
override.md"), so mapping it bare risks colliding with those.

PlantWaveApplication hands this file to KeySoft on launch.
-->
<keymapping>
    <application package="org.aph.plantwave">
        <context viewIdResourceName="SelfBraillingWidget">
            <action name="substitute">
                <command commandId="action_zoom_in" finishComposing="true" param="168" string="context_menu_zoom_in">
                    <key>ZoomIn</key>
                </command>
                <command commandId="action_zoom_out" convertToCharacter="true" finishComposing="true" param="169" savePanning="true" string="context_menu_zoom_out">
                    <key>ZoomOut</key>
                </command>
                <command commandId="enter" param="66">
                    <key>Dots8</key>
                </command>
            </action>
        </context>
    </application>
</keymapping>
